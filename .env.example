# copy to .env and fill in — .env is gitignored, never commit real values

# required: Telegram bot token from @BotFather
BOT_TOKEN=

# required for MultiTransfer: the fhpsessionid request header of any
# /commissions call on multitransfer.ru, taken from devtools. Without it the
# bot prints "MltTr — session expired?" and the other providers keep working.
# See docs/adr/0001-multitransfer-antifraud-session.md
MT_FHP_SESSION_ID=

# optional: database location, defaults to db/db.json
# DB_PATH=db/db.json

# optional: font directory, defaults to assets/
# ASSETS_PATH=assets
