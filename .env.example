# copy to .env and fill in — .env is gitignored, never commit real values

# required: Telegram bot token from @BotFather
BOT_TOKEN=

# development only — the Docker image sets this itself: the chromium that mints
# the MultiTransfer antifraud session. Point it at a local Chrome, e.g. on macOS
# "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome". Without it the
# bot prints "MltTr — no antifraud session" and the other providers keep
# working. See docs/adr/0001-multitransfer-antifraud-session.md
CHROMIUM_PATH=

# optional: database location, defaults to db/db.json
# DB_PATH=db/db.json

# optional: font directory, defaults to assets/
# ASSETS_PATH=assets
